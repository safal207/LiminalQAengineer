{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LiminalQAengineer/schemas/causal-deep-audit-packet.schema.json",
  "title": "Causal Deep-Audit Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "target",
    "scope",
    "source_identity",
    "authority",
    "verdict",
    "findings",
    "evidence_ledger",
    "limitations",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "liminalqa-causal-deep-audit-packet-v0.1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["public_product", "authenticated_product", "repository", "pull_request", "agent_action", "mixed"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_origin": {
          "type": "string"
        },
        "repository_full_name": {
          "type": "string"
        },
        "pull_request_number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "profiles", "stop_conditions"],
      "properties": {
        "included": {
          "type": "array",
          "items": {"type": "string"}
        },
        "excluded": {
          "type": "array",
          "items": {"type": "string"}
        },
        "profiles": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stop_conditions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_type", "value", "initial_check", "final_check"],
      "properties": {
        "identity_type": {
          "enum": ["commit_sha", "response_hash", "release", "run_attempt", "mixed"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "run_id": {
          "type": "string"
        },
        "run_attempt": {
          "type": "string"
        },
        "initial_check": {
          "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]
        },
        "final_check": {
          "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed", "prohibited"],
      "properties": {
        "mode": {
          "enum": ["evidence_only", "advisory_only", "authorized_test"]
        },
        "allowed": {
          "type": "array",
          "items": {"type": "string"}
        },
        "prohibited": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "gate", "summary"],
      "properties": {
        "state": {
          "enum": [
            "NOT_RUN",
            "NEEDS_EVIDENCE",
            "PRODUCT_SIGNAL",
            "CONFIRMED_PRODUCT_DEFECT_CANDIDATE",
            "CONFIRMED_DEFECT",
            "BLOCKED_BY_BOUNDARY",
            "INCOMPLETE",
            "HOLD",
            "READY_WITH_ADVISORY_GAPS"
          ]
        },
        "gate": {
          "enum": ["ALLOW_REPORT", "ESCALATE", "BLOCK"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "action", "completion_signal", "stop_condition"],
      "properties": {
        "class": {
          "enum": [
            "COLLECT_EVIDENCE",
            "RUN_DISCRIMINATING_TEST",
            "FIX_CONFIRMED_DEFECT",
            "ADD_GUARDRAIL",
            "MEASURE_IMPACT",
            "HUMAN_ADJUDICATION",
            "DEFER_WITH_WATCHPOINT",
            "STOP_AT_BOUNDARY"
          ]
        },
        "action": {"type": "string", "minLength": 1},
        "owner_or_authority": {"type": "string"},
        "completion_signal": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "title",
        "claim_level",
        "severity",
        "confidence",
        "reproduction_status",
        "trace_refs",
        "evidence_refs",
        "causal_parent",
        "competing_explanations",
        "impact_class",
        "next_discriminating_test",
        "authority_boundary"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "claim_level": {
          "enum": ["OBSERVATION", "PRODUCT_SIGNAL", "DEFECT_CANDIDATE", "CONFIRMED_DEFECT", "ROOT_CAUSE_HYPOTHESIS", "CONFIRMED_ROOT_CAUSE"]
        },
        "severity": {
          "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNASSESSED"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reproduction_status": {
          "enum": ["NOT_RUN", "NOT_REPRODUCED", "PARTIAL", "REPRODUCED", "BLOCKED"]
        },
        "trace_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "causal_parent": {
          "type": ["string", "null"]
        },
        "causal_gap_code": {
          "enum": ["CML-AUDIT-R1-MISSING_PARENT", "CML-AUDIT-R2-GAP_NOT_MARKED", "CML-AUDIT-R3-SECRET_NET_MISSING_CHAIN", "CML-AUDIT-R4-AMBIGUOUS_ROOT"]
        },
        "competing_explanations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "impact_class": {
          "enum": ["MEASURED", "MODELED", "QUALITATIVE", "UNKNOWN"]
        },
        "next_discriminating_test": {
          "type": "string",
          "minLength": 1
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "type", "status", "observed_at", "integrity"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["source", "rendered", "runtime", "accessibility", "network", "repository", "review", "memory", "measurement", "other"]
        },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_RUN", "UNAVAILABLE", "STALE", "INCOMPLETE", "OBSERVED"]
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_time": {"type": "string", "format": "date-time"},
        "transaction_time": {"type": "string", "format": "date-time"},
        "ref": {"type": "string"},
        "integrity": {
          "enum": ["VERIFIED", "UNVERIFIED", "NOT_APPLICABLE"]
        }
      }
    }
  }
}
