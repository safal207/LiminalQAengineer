{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/LiminalQAengineer/integrations/lotus/contracts/lotus-run-v0.1.schema.json",
  "title": "LiminalQA Lotus Evidence Run v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "target",
    "source_base",
    "protocol_pins",
    "claims",
    "lotus",
    "drp_decision",
    "liminaldb_projection",
    "evidence_manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "lqa-lotus-run/0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "executed",
        "closed"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "name",
        "surface",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source_base": {
      "type": "object",
      "required": [
        "repository",
        "head_sha"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "protocol_pins": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "repository",
          "commit_sha",
          "role"
        ],
        "properties": {
          "name": {
            "enum": [
              "T-Trace",
              "DRP",
              "ProofPath",
              "LiminalDB"
            ]
          },
          "repository": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "kind",
          "text",
          "evidence_grade"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fact",
              "observation",
              "hypothesis"
            ]
          },
          "text": {
            "type": "string"
          },
          "evidence_grade": {
            "enum": [
              "F0",
              "F1",
              "F2",
              "F3",
              "F4",
              "F5"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "lotus": {
      "type": "object",
      "required": [
        "pythia",
        "cml",
        "ls"
      ],
      "properties": {
        "pythia": {
          "type": "object",
          "required": [
            "verdict",
            "confirmed_defect",
            "reasons"
          ],
          "properties": {
            "verdict": {
              "enum": [
                "ALLOW",
                "ESCALATE",
                "BLOCK"
              ]
            },
            "confirmed_defect": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cml": {
          "type": "object"
        },
        "ls": {
          "type": "object"
        }
      }
    },
    "drp_decision": {
      "type": "object",
      "required": [
        "record_id",
        "timestamp",
        "context",
        "decision",
        "options",
        "status"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "draft",
            "complete",
            "superseded"
          ]
        },
        "supersedes_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "liminaldb_projection": {
      "type": "object",
      "required": [
        "event_kind",
        "entity_id",
        "valid_time",
        "transaction_time",
        "append_only"
      ],
      "properties": {
        "event_kind": {
          "const": "qa.audit.run"
        },
        "entity_id": {
          "type": "string"
        },
        "valid_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "transaction_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "append_only": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "evidence_manifest": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
