  "checkpoints": [
    {
      "id": "idle-long-chat",
      "instruction": "Open an existing long conversation and leave the page idle near the middle of the thread."
    },
    {
      "id": "return-to-latest",
      "instruction": "Use the product UI to return to the latest message, then capture."
    },
    {
      "id": "composer-multiline-keyboard-open",
      "instruction": "Manually place a benign multi-line draft in the composer with the real virtual keyboard open. Do not submit it."
    },
    {
      "id": "streaming-active",
      "instruction": "In a dedicated non-sensitive test chat, manually submit a benign prompt and capture while the answer is streaming."
    },
    {
      "id": "stream-stopped-or-complete",
      "instruction": "Manually stop the stream or wait for completion, then capture the recovery state."
    },
    {
      "id": "attachment-tray-open",
      "instruction": "Open the attachment tray without selecting or uploading a file."
    },
    {
      "id": "sidebar-history-open",
      "instruction": "Open the sidebar/history surface and capture without opening a private title that should not be exposed."
    },
    {
      "id": "search-widget-or-source-panel",
      "instruction": "Open a non-sensitive Search result, widget, or source panel when available."
    },
    {
      "id": "offline",
      "instruction": "Use browser DevTools to go offline after preserving the current draft, then capture."
    },
    {
      "id": "recovered-online",
      "instruction": "Restore connectivity and capture the recovered state."
    },
    {
      "id": "browser-zoom-200",
      "instruction": "Set browser zoom or accessibility text scaling to the intended 200 percent test state, then capture."
    }
  ],
  "stop_conditions": [
    "attached page is not on chatgpt.com",
    "signed-in state cannot be established",
    "capture would require entering or exporting credentials",
    "capture would persist raw private conversation text",
    "browser debugging target is shared with an unrelated sensitive page",
    "a challenge or access-control boundary appears",
    "the user withdraws consent"
  ],
  "evidence_labels": [
    "AUTHENTICATED_LOCAL_EVIDENCE",
    "USER_DRIVEN_CHECKPOINT",
    "PRIVATE_TEXT_REDACTED",
    "NEEDS_REAL_DEVICE_EVIDENCE",
    "USER_IMPACT_UNKNOWN",
    "HUMAN_REVIEW_REQUIRED"
  ],
  "verdict_before_capture": "PENDING_AUTHORIZED_LOCAL_EVIDENCE"
}
