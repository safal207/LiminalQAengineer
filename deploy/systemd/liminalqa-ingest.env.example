# /etc/liminalqa/ingest.env
# Copy to /etc/liminalqa/ingest.env and fill in real values.
# Protect with: chmod 600 /etc/liminalqa/ingest.env

LIMINAL_AUTH_TOKEN=change-me-use-openssl-rand-hex-32
LIMINAL_BIND_ADDR=0.0.0.0:8080
LIMINAL_GRPC_ADDR=0.0.0.0:50051
LIMINAL_DB_PATH=/var/lib/liminalqa/db
LIMINAL_RATE_LIMIT_RPS=1000
RUST_LOG=info
